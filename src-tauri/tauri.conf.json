{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapify - Spotify Overlay",
  "version": "1.0.0",
  "identifier": "com.snapify.spotify-overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snapify - Spotify Overlay",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 300,
        "fullscreen": false,
        "maximized": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "maximizable": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
